# Frontend (Vite) - put these in .env.local
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Convex deployment (`npx convex dev` writes this to .env.local)
CONVEX_DEPLOYMENT=

# Convex server-side settings. Set each one with `npx convex env set NAME value`;
# Convex does not read this file.

# Clerk: your Frontend API URL (issuer), e.g. https://your-name-12.clerk.accounts.dev
CLERK_SIGNING_KEY=

# Speech-to-text (Groq Whisper)
GROQ_API_KEY=

# Language model for entity extraction and medical reports: any OpenAI-compatible
# chat completions API. Defaults to OpenAI when LLM_BASE_URL is not set.
#   OpenAI: LLM_MODEL=gpt-4
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#           LLM_MODEL=gemini-flash-latest
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Clinical trial analysis (ASI-1)
ASI1_API_KEY=
ASI1_BASE_URL=https://api.asi1.ai
ASI1_MODEL=asi1-mini
