# Frontend (Vite)
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Convex deployment (npx convex dev writes these to .env.local)
CONVEX_DEPLOYMENT=

# Convex server-side secrets: set with `npx convex env set NAME value`, not read from this file
CLERK_SIGNING_KEY=
GROQ_API_KEY=
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
ASI1_API_KEY=
ASI1_BASE_URL=https://api.asi1.ai
ASI1_MODEL=asi1-mini
